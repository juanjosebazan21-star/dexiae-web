# Cloudflare Pages — headers por ruta.
# OJO: este archivo NO se sirve, lo consume el build de Pages.

# La demo es la app real embebida (~670 KB de UI). No debe indexarse: las
# puertas de SEO son la home y las paginas de casos de uso, extractos y
# facturas (/demo redirige a /app desde 09/2026). Sin esto Google la trata
# como pagina mas y compite con la home por relevancia.
/app/*
  X-Robots-Tag: noindex, follow

# La capa de la demo se carga con ?v=<hash> (redes/sync_demo_app.py), pero
# por las dudas: que el navegador pregunte siempre (con ETag, cuesta poco).
# Con la caché de 4 h un navegador que ya había entrado mezclaba la UI nueva
# con la capa vieja (24/09/2026).
/app/demo-web.js
  Cache-Control: no-cache

# Los Excel de ejemplo tampoco son contenido de busqueda.
/app/ejemplos/*
  X-Robots-Tag: noindex

# Cupos fundadores de DEXIAE Contable: se baja a mano con cada estudio
# que se suma; que nadie vea un numero viejo (lo lee lead.js).
/cupos-fundadores.json
  Cache-Control: no-cache

# Capturas y assets: cache de 1 dia. OJO: el borde de Cloudflare NO las
# invalida al deployar (01/10/2026: servia las capturas viejas con Age de 21 h).
# Al reemplazar una imagen, referenciarla con ?v=<huella> en el HTML.
/*.png
  Cache-Control: public, max-age=86400

/*.jpg
  Cache-Control: public, max-age=86400

/*.webp
  Cache-Control: public, max-age=86400

# Endurecimiento basico (no afecta SEO, evita sorpresas).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
